<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Com.H</AssemblyName>
    <RootNamespace>Com.H</RootNamespace>
    <Version>10.3.1</Version>
    <Authors>Hussein Al Bayati</Authors>
    <Description>General purpose library containing, in its current form, a very small collection of helpful functionalties that don't warrent a seperate library for each at this early stage.</Description>
    <Copyright>Hussein Al Bayati</Copyright>
    <PackageProjectUrl>https://github.com/H7O/Com.H</PackageProjectUrl>
    <PackageIcon>128x128.jpg</PackageIcon>
    <PackageReadmeFile>nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>general purpose</PackageTags>
    <PackageReleaseNotes>
10.3.1

* Fixed: IOExtensions.UnifyPathSeperator collapsed the leading \\ of a UNC path, so
  \\server\share\file became \server\share\file, which Windows resolves against the current
  drive (C:\server\share\file). On Windows the run of separators at the start of a path is now
  reduced to exactly two instead of one, so //server/share/file becomes \\server\share\file and
  \\?\ and \\.\ device paths survive. Nothing changes on Linux or macOS.
  If you pass caller-supplied relative paths through it before Path.Combine, a value starting
  with // or \\ now comes back as a UNC path to another machine. Strip leading separators first.

Upgrading from 10.2.x or earlier? 10.3.0 changed how Com.H.Shell and Com.H.Pdf behave, which
matters if you run external commands or convert HTML to PDF. Its notes list every change:
https://www.nuget.org/packages/Com.H/10.3.0#releasenotes-body-tab
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/H7O/Com.H</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- Deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    
    <!-- Source Link - enables stepping into source code when debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    
    <!-- Embed debug symbols in the assembly (avoids separate .snupkg) -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Source Link for GitHub -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <!-- Polyfill packages that bring netstandard2.0 to feature parity with the
       modern targets (dynamic runtime binder, System.Text.Json, IAsyncEnumerable).
       Versions are kept in lockstep with Com.H.Data.Common so consumers referencing
       both packages don't hit conflicting transitive versions. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\128x128.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
